{
  "name": "frontend-yakuwise",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage --coverage-reporters text --coverage-reporters lcovonly"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "jsdom": {
      "lru-cache": "^11.5.2"
    }
  },
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@angular/common": "^21.2.7",
    "@angular/compiler": "^21.2.7",
    "@angular/core": "^21.2.7",
    "@angular/forms": "^21.2.7",
    "@angular/platform-browser": "^21.2.7",
    "@angular/router": "^21.2.7",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.7",
    "@vitest/coverage-v8": "^4.1.2",
    "baseline-browser-mapping": "^2.10.15",
    "jsdom": "^29.0.1",
    "rxjs": "^7.8.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.2"
  }
}
